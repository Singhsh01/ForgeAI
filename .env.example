# ──────────────────────── ForgeAI configuration ─────────────────────────
# Copy to .env and fill in. Never commit .env.

# Login for the local single-operator account (required).
FORGEAI_ADMIN_EMAIL=you@example.com
FORGEAI_ADMIN_PASSWORD=change-me-to-a-long-passphrase
# 32+ random chars used to sign session cookies:  openssl rand -hex 32
FORGEAI_SESSION_SECRET=

# ── AI model (pick ONE provider) ─────────────────────────────────────────
# nvidia  = NVIDIA Nemotron via build.nvidia.com (free API key, starts with nvapi-)
# google  = Google Gemini via Google AI Studio (free API key, starts with AIza)
# openai-compatible = any other OpenAI-style endpoint (set FORGEAI_LLM_BASE_URL + FORGEAI_LLM_API_KEY)
# anthropic = Claude via the Agent SDK (paid ANTHROPIC_API_KEY)
FORGEAI_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
GEMINI_API_KEY=
# Optional: override the default model for the chosen provider
#   nvidia default: nvidia/nemotron-3-super-120b-a12b
#   google default: gemini-3.8-flash
FORGEAI_MODEL=
# Optional: extra JSON merged into every request, e.g. {"reasoning_effort":"low"} for Gemini
FORGEAI_LLM_EXTRA_BODY=
# Optional: price per million tokens, used for cost tracking (free tiers: leave 0)
FORGEAI_PRICE_INPUT_PER_MTOK=0
FORGEAI_PRICE_OUTPUT_PER_MTOK=0
ANTHROPIC_API_KEY=

# Budgets enforced per run by the workflow controller
FORGEAI_MAX_TOKENS=3000000
FORGEAI_MAX_COST_USD=3
FORGEAI_MAX_REPAIR_ATTEMPTS=2
FORGEAI_MAX_AGENT_TURNS=40
FORGEAI_RUN_TIMEOUT_MS=1800000

# GitHub — fine-grained PAT scoped to the repos you connect
# (Contents: read/write, Issues: read, Pull requests: read/write, Metadata: read).
# Deliberately NOT named GITHUB_TOKEN so an ambient CI/CLI token is never picked up by accident.
FORGEAI_GITHUB_TOKEN=

# Database — leave empty to use the embedded PGlite Postgres in .forgeai/pgdata.
# DATABASE_URL=postgres://forgeai:forgeai@localhost:5432/forgeai

# Execution sandbox: docker (recommended) | process (UNSAFE dev fallback, no isolation)
FORGEAI_SANDBOX_DRIVER=docker
FORGEAI_SANDBOX_IMAGE=forgeai-sandbox:latest
FORGEAI_SANDBOX_MEMORY=2g
FORGEAI_SANDBOX_CPUS=2
FORGEAI_SANDBOX_TIMEOUT_MS=600000
# Allow network during dependency install step only (tests always run with --network none)
FORGEAI_SANDBOX_INSTALL_NETWORK=true

# Local repositories: comma-separated absolute directories ForgeAI may read from.
FORGEAI_LOCAL_REPO_ROOTS=

# OpenTelemetry — optional OTLP/HTTP collector, e.g. http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
