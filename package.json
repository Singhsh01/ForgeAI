{
  "name": "forgeai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "eval": "tsx eval/run.ts",
    "eval:validate": "tsx eval/validate.ts",
    "sandbox:build": "docker build -t forgeai-sandbox:latest -f docker/sandbox.Dockerfile docker",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
